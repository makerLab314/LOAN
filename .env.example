APP_NAME=LOAN
APP_ENV=production
# Erzeugen mit: docker compose run --rm loan php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://loan.example.org
# Port, auf dem nginx auf dem Host lauscht
APP_PORT=8080
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

# Wenn LOAN hinter einem Reverse Proxy mit TLS läuft (empfohlen): "*" oder IP-Bereich
TRUSTED_PROXIES=*

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=loan
DB_USERNAME=loan
# Starke Passwörter setzen! Bei bestehender Installation: siehe UPGRADE.md
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true, sobald LOAN über HTTPS erreichbar ist
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Für "Passwort vergessen"
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="loan@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# Backups (Datenbank + Uploads), werden täglich vom Scheduler erstellt
BACKUP_PATH=/var/backups/loan
